{
    "name": "smart-city-mcp",
    "version": "1.0.0",
    "description": "MCP server over the Smart City API: the client profile",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "engines": {
        "node": ">=22.0.0"
    },
    "bin": {
        "smart-city-mcp": "dist/main.js"
    },
    "main": "dist/main.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "codegen": "node scripts/codegen.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
        "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.30.0",
        "date-fns": "4.4.0",
        "date-fns-tz": "3.2.0",
        "zod": "4.6.1"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/jest": "30.0.0",
        "@types/node": "22.20.2",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import": "2.32.0",
        "jest": "30.5.1",
        "openapi-typescript": "7.13.0",
        "prettier": "3.9.6",
        "ts-jest": "29.4.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
