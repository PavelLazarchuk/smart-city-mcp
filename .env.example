# Base URL of the Smart City API, including the /api/v1 prefix
SMART_CITY_API_URL=http://localhost:8080/api/v1

SMART_CITY_TZ=Europe/Berlin

# Off by default. When false, no booking, cancelling, rescheduling, waitlist or account-write tool
# is registered at all: the model cannot offer what is not in tools/list.
SMART_CITY_MCP_WRITE=false

# Off by default. When false, phone numbers come back masked, form answers as keys only, and the
# name on a booking not at all.
SMART_CITY_MCP_PII=false

# Where the token pair is kept. The file is written 0600 inside a 0700 directory.
SMART_CITY_SESSION_PATH=~/.smart-city-mcp/session.json

# Tool calls allowed per server process before calls are refused with an explanation.
SMART_CITY_MCP_TOOL_BUDGET=40

# silent | error | warn | info | debug. Logs go to stderr only: stdout carries the protocol.
LOG_LEVEL=warn
